<body onload="SyncThemAll()">

<!-- Professional Header -->
<div class="header">
    <div class="header-left">
        <div class="app-title">
            <i class="fas fa-microscope"></i>
            <a href="https://polyscope.mdanderson.org">
                Polyscope
            </a>
        </div>
        <div class="slide-info">
            _SLIDE_INFO_ - Deep Zoom Viewer
        </div>
    </div>
    
    <div class="header-controls">
        <button class="header-btn" onclick="shareSlide()">
            <i class="fas fa-share-alt"></i> Share
        </button>
        <button class="header-btn" onclick="toggleFullscreen()">
            <i class="fas fa-expand"></i> Fullscreen
        </button>
        <div class="export-btn-container">
            <button class="header-btn" onclick="toggleExportDropdown()">
                <i class="fas fa-download"></i> Export
                <i class="fas fa-chevron-down export-arrow"></i>
            </button>
            <div class="export-dropdown" id="exportDropdown">
                <div class="export-option" onclick="exportAnnotationsTXT()">
                    <i class="fas fa-file-alt"></i>
                    <span>Annotations TXT</span>
                </div>
                <div class="export-option" onclick="exportAnnotationsCSV()">
                    <i class="fas fa-file-csv"></i>
                    <span>Annotations CSV</span>
                </div>
                <div class="export-option" onclick="exportAnnotationsGeoJSON()">
                    <i class="fas fa-file-code"></i>
                    <span>Annotations JSON</span>
                </div>
            </div>
        </div>
        <button class="header-btn" onclick="takeScreenshot()">
            <i class="fas fa-camera"></i> Screenshot
        </button>
        <button class="header-btn back-btn" onclick="goBack()">
            <i class="fas fa-arrow-left"></i> Back
        </button>
    </div>
</div>

<!-- Main Container -->
<div class="container">
    <!-- Sidebar Toggle -->
	<button class="sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()">
		<i class="fas fa-chevron-left"></i>
	</button>

    <!-- Professional Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-tools"></i>
            Analysis Tools
        </div>
        
        <div class="sidebar-content">
			<!-- Image Controls Section -->
			<div class="section">
				<div class="section-header" onclick="toggleSection(this)">
					<span><i class="fas fa-sliders-h"></i> Image Controls</span>
					<i class="fas fa-chevron-down"></i>
				</div>
				<div class="section-content">
					<div class="control-group">
						<label class="control-label">Brightness</label>
						<div class="slider-container">
							<input type="range" class="control-slider" id="brightness" min="0" max="200" value="100" oninput="updateImageControl(this)">
							<span class="slider-value">100%</span>
						</div>
					</div>
					
					<div class="control-group">
						<label class="control-label">Contrast</label>
						<div class="slider-container">
							<input type="range" class="control-slider" id="contrast" min="0" max="200" value="100" oninput="updateImageControl(this)">
							<span class="slider-value">100%</span>
						</div>
					</div>
					
					<div class="control-group">
						<label class="control-label">Saturation</label>
						<div class="slider-container">
							<input type="range" class="control-slider" id="saturation" min="0" max="200" value="100" oninput="updateImageControl(this)">
							<span class="slider-value">100%</span>
						</div>
					</div>
					
					<div class="control-buttons">
						<button class="action-btn primary" onclick="resetImageControls()">
							<i class="fas fa-undo"></i> Reset
						</button>
					</div>
				</div>
			</div>
			
			<!-- Annotations Section -->
            <div class="section">
				<div class="section-header" onclick="toggleSection(this)">
					<span><i class="fas fa-sticky-note"></i> Annotations</span>
					<i class="fas fa-chevron-down"></i>
				</div>
				<div class="section-content">
					<div id="annotationSummaryDisplay" class="annotation-summary"></div>
					<!-- Hidden download button for enhanced annotation manager compatibility -->
					<a id="downloadAnnotationsBtn" href="_ANNOTATIONS_LINK_" download="Annotations__PATIENT_ID__CHANNEL_ID_.txt" style="display: none;">
						<i class="fas fa-download"></i> Download
					</a>
				</div>
            </div>

            <!-- Cell Segmentation Section -->
            <div class="section">
                <div class="section-header" onclick="toggleSection(this)">
                    <span><i class="fas fa-brain"></i> AI-Powered Region Analysis</span>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="section-content">
                    <!-- Zoom Level Warning -->
                    <div class="zoom-warning" id="zoomWarning" style="display: none;">
                        <div class="warning-content">
                            <i class="fas fa-search-plus"></i>
                            <span>Zoom to maximum level for accurate AI analysis</span>
                        </div>
                    </div>
                    
                    <!-- AI Service Status -->
                    <div class="ai-status-container">
                        <div id="simple-region-status" class="ai-status ai-status-warning">Checking AI service...</div>
                    </div>
                    
                    <!-- Simplified Model Selection -->
                    <div class="control-item" style="margin-top: 12px;">
                        <label class="control-label">AI Model:</label>
                        <select id="aiModelSelect" class="control-select" style="width: 100%; margin-top: 4px;">
                            <option value="vitaminp-resnet34-he">✅ VitaminP-ResNet34 (H&E)</option>
                            <option value="vitaminp-dino-base-he-mif" disabled>🔒 VitaminP-DiNO-Base - Coming Soon</option>
                            <option value="vitaminp-resnet50-he" disabled>🔒 VitaminP-ResNet50 - Coming Soon</option>
                        </select>
                        
                        <div id="currentModelStatus" class="model-status available" style="margin-top: 8px;">
                            <i class="fas fa-check-circle"></i> Available
                        </div>
                    </div>
                    
                    <!-- Control Buttons -->
                    <div class="control-item">
                        <button class="action-btn primary" onclick="startRegionSelection()" 
                                style="width: 48%; margin-right: 4%;">
                            <i class="fas fa-play"></i> Start Analysis
                        </button>
                        <button class="action-btn secondary" onclick="stopRegionSelection()" style="width: 48%;">
                            <i class="fas fa-stop"></i> Stop
                        </button>
                    </div>
                    
                    <div class="control-item" style="margin-top: 8px;">
                        <button class="action-btn danger" onclick="clearResults()" style="width: 100%;">
                            <i class="fas fa-trash"></i> Clear Results
                        </button>
                    </div>
                    
                    <!-- Zoom Level Indicator -->
                    <div class="zoom-indicator" id="zoomIndicator">
                        <div class="zoom-label">Current Zoom Level:</div>
                        <div class="zoom-bar">
                            <div class="zoom-progress" id="zoomProgress"></div>
                        </div>
                        <div class="zoom-text" id="zoomText">0% of maximum</div>
                    </div>
                    
                    <!-- Simplified Instructions -->
                    <div class="analysis-instructions">
                        <h5><i class="fas fa-info-circle"></i> Quick Guide:</h5>
                        <ol>
                            <li><strong>Zoom to maximum</strong> on region of interest</li>
                            <li>Click "Start Analysis" when ready</li>
                            <li>Draw rectangle around cells</li>
                            <li>AI will detect and count cells</li>
                        </ol>
                    </div>
                    
                    <!-- Results Display -->
                    <div id="simple-region-image" style="margin: 12px 0;">
                        <div class="no-selection-message">
                            <i class="fas fa-mouse-pointer"></i>
                            <p>Zoom to maximum and select a region to begin AI analysis</p>
                        </div>
                    </div>
                    
                    <!-- Hidden info container for coordinate display -->
                    <div id="simple-region-info" style="display: none;"></div>
                </div>
            </div>
            <!-- WSI Analysis Section - NEW -->
            <div class="section">
                <div class="section-header" onclick="toggleSection(this)">
                    <span><i class="fas fa-microscope"></i> AI-Powered WSI Analysis</span>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="section-content">
                    <!-- WSI AI Service Status -->
                    <div class="ai-status-container">
                        <div id="wsi-ai-status" class="ai-status ai-status-warning">Checking WSI AI service...</div>
                    </div>
                    
                    <!-- WSI Model Selection (Same as region analysis) -->
                    <div class="control-item" style="margin-top: 12px;">
                        <label class="control-label">WSI AI Model:</label>
                        <select id="wsiModelSelect" class="control-select" style="width: 100%; margin-top: 4px;">
                            <option value="vitaminp-resnet34-he">✅ VitaminP-ResNet34 (H&E)</option>
                            <option value="vitaminp-dino-base-he-mif" disabled>🔒 VitaminP-DiNO-Base - Coming Soon</option>
                            <option value="vitaminp-resnet50-he" disabled>🔒 VitaminP-ResNet50 - Coming Soon</option>
                        </select>
                        
                        <div id="currentWSIModelStatus" class="model-status available" style="margin-top: 8px;">
                            <i class="fas fa-check-circle"></i> Available
                        </div>
                    </div>
                    
                    <!-- WSI Tiling Parameters -->
                    <div class="control-item">
                        <label class="control-label">Tile Size:</label>
                        <select id="wsiTileSize" class="control-select" style="width: 100%; margin-top: 4px;">
                            <option value="512">512x512 pixels</option>
                            <option value="1024" selected>1024x1024 pixels</option>
                            <option value="2048">2048x2048 pixels</option>
                        </select>
                    </div>
                    
                    <!-- WSI Progress Indicator -->
                    <div class="wsi-progress-container" id="wsiProgressContainer" style="display: none;">
                        <div class="progress-label">Processing WSI...</div>
                        <div class="progress-bar">
                            <div class="progress-fill" id="wsiProgressFill"></div>
                        </div>
                        <div class="progress-text" id="wsiProgressText">0% complete</div>
                        <div class="progress-detail" id="wsiProgressDetail">Initializing...</div>
                    </div>
                    
                    <!-- Control Buttons -->
                    <div class="control-item">
                        <button class="action-btn primary" onclick="startWSIAnalysis()" 
                                style="width: 48%; margin-right: 4%;">
                            <i class="fas fa-play"></i> Start WSI Analysis
                        </button>
                        <button class="action-btn secondary" onclick="stopWSIAnalysis()" style="width: 48%;">
                            <i class="fas fa-stop"></i> Stop
                        </button>
                    </div>
                    
                    <div class="control-item" style="margin-top: 8px;">
                        <button class="action-btn danger" onclick="clearWSIResults()" style="width: 100%;">
                            <i class="fas fa-trash"></i> Clear WSI Results
                        </button>
                    </div>
                    
                    <!-- WSI Instructions -->
                    <div class="analysis-instructions">
                        <h5><i class="fas fa-info-circle"></i> WSI Analysis Guide:</h5>
                        <ol>
                            <li><strong>Select tile size</strong> for processing</li>
                            <li>Click "Start WSI Analysis"</li>
                            <li>AI will process entire slide in tiles</li>
                            <li>View aggregated results as overlay</li>
                        </ol>
                    </div>
                    
                    <!-- WSI Results Display -->
                    <div id="wsi-results-container" style="margin: 12px 0;">
                        <div class="no-selection-message">
                            <i class="fas fa-microscope"></i>
                            <p>Click "Start WSI Analysis" to analyze the entire slide</p>
                        </div>
                    </div>
                    
                    <!-- Hidden info container for WSI data -->
                    <div id="wsi-analysis-info" style="display: none;"></div>
                </div>
            </div>

            <!-- TME Segmentation Section - Add this AFTER the "AI-Powered WSI Analysis" section -->
            <div class="section">
                <div class="section-header" onclick="toggleSection(this)">
                    <span><i class="fas fa-layer-group"></i> TME Tissue Segmentation</span>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="section-content">
                    <!-- TME AI Service Status -->
                    <div class="ai-status-container">
                        <div id="tme-ai-status" class="ai-status ai-status-warning">Checking TME AI service...</div>
                    </div>
                    
                    <!-- TME Model Selection -->
                    <div class="control-item" style="margin-top: 12px;">
                        <label class="control-label">TME Model:</label>
                        <select id="tmeModelSelect" class="control-select" style="width: 100%; margin-top: 4px;">
                            <option value="mit-b3-finetuned-TCGAbcssWsss10xLuadMacroMuscle-40x896-20x512-10x256re">
                                ✅ SegFormer MIT-B3 (Lung)
                            </option>
                            <option value="custom-model-breast" disabled>🔒 Breast Model - Coming Soon</option>
                            <option value="custom-model-colon" disabled>🔒 Colon Model - Coming Soon</option>
                        </select>
                        
                        <div id="currentTMEModelStatus" class="model-status available" style="margin-top: 8px;">
                            <i class="fas fa-check-circle"></i> Available
                        </div>
                    </div>
                    
                    <!-- Processing Parameters -->
                    <div class="control-item">
                        <label class="control-label">Patch Size:</label>
                        <select id="tmePatchSize" class="control-select" style="width: 100%; margin-top: 4px;">
                            <option value="256">256x256 pixels</option>
                            <option value="512" selected>512x512 pixels</option>
                            <option value="896">896x896 pixels</option>
                        </select>
                    </div>
                    
                    <div class="control-item">
                        <label class="control-label">Scale Factor:</label>
                        <select id="tmeScaleFactor" class="control-select" style="width: 100%; margin-top: 4px;">
                            <option value="0.03125">3.125% (1/32)</option>
                            <option value="0.0625" selected>6.25% (1/16)</option>
                            <option value="0.125">12.5% (1/8)</option>
                        </select>
                    </div>
                    
                    <div class="control-item">
                        <label class="control-label">
                            <input type="checkbox" id="tmeColorNorm" style="margin-right: 8px;">
                            Apply Color Normalization
                        </label>
                    </div>
                    
                    <!-- TME Progress Indicator -->
                    <div class="wsi-progress-container" id="tmeProgressContainer" style="display: none;">
                        <div class="progress-label">Processing TME Segmentation...</div>
                        <div class="progress-bar">
                            <div class="progress-fill" id="tmeProgressFill"></div>
                        </div>
                        <div class="progress-text" id="tmeProgressText">0% complete</div>
                        <div class="progress-detail" id="tmeProgressDetail">Initializing...</div>
                    </div>
                    
                    <!-- Control Buttons -->
                    <div class="control-item">
                        <button class="action-btn primary" onclick="startTMEAnalysis()" 
                                style="width: 48%; margin-right: 4%;">
                            <i class="fas fa-play"></i> Start TME Analysis
                        </button>
                        <button class="action-btn secondary" onclick="stopTMEAnalysis()" style="width: 48%;">
                            <i class="fas fa-stop"></i> Stop
                        </button>
                    </div>
                    
                    <div class="control-item" style="margin-top: 8px;">
                        <button class="action-btn danger" onclick="clearTMEResults()" style="width: 100%;">
                            <i class="fas fa-trash"></i> Clear TME Results
                        </button>
                    </div>
                    
                    <!-- TME Tissue Classes Legend -->
                    <!-- TME Tissue Classes Legend -->
                    <!-- TME Tissue Classes Legend -->
                    <div class="tme-legend" style="margin: 12px 0; padding: 10px; background: #f8f9fa; border-radius: 6px; border: 1px solid #dee2e6;">
                        <h5 style="margin: 0 0 8px 0; font-size: 11px; font-weight: 600; color: #495057;">
                            <i class="fas fa-palette"></i> Tissue Classes (11)
                        </h5>
                        <div style="display: grid; grid-template-columns: 1fr; gap: 4px; font-size: 10px;">
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #000000; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Non tissue</span>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #8B0000; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Tumor</span>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #FFFF00; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Non-inflamed stroma</span>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #FF0000; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Inflamed stroma</span>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #FF00FF; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Necrosis/Hemorrhage</span>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #808000; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Adipose tissue</span>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #00FFFF; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Bronchial epithelium</span>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #0000FF; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Microvessel</span>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #800080; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Foam-like macrophages</span>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #008000; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Alveoli</span>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <div style="width: 16px; height: 16px; background: #000080; border: 1px solid #ccc; margin-right: 6px; border-radius: 2px;"></div>
                                <span>Muscle tissue</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- TME Instructions -->
                    <div class="analysis-instructions">
                        <h5><i class="fas fa-info-circle"></i> TME Analysis Guide:</h5>
                        <ol>
                            <li><strong>Configure parameters</strong> (patch size, scale)</li>
                            <li>Click "Start TME Analysis"</li>
                            <li>AI segments entire slide into tissue classes</li>
                            <li>View overlay and statistics</li>
                        </ol>
                    </div>
                    
                    <!-- TME Results Display -->
                    <div id="tme-results-container" style="margin: 12px 0;">
                        <div class="no-selection-message">
                            <i class="fas fa-layer-group"></i>
                            <p>Click "Start TME Analysis" to segment tissue types across the whole slide</p>
                        </div>
                    </div>
                    
                    <!-- Job Status Display -->
                    <div id="tme-job-status" style="display: none; margin: 12px 0; padding: 10px; background: #e3f2fd; border-radius: 6px; border: 1px solid #2196f3;">
                        <div style="font-size: 11px; font-weight: 600; color: #1976d2; margin-bottom: 6px;">
                            <i class="fas fa-tasks"></i> Current Job
                        </div>
                        <div id="tme-job-id" style="font-size: 10px; color: #495057; font-family: monospace; margin-bottom: 4px;"></div>
                        <div id="tme-job-progress" style="font-size: 10px; color: #495057;"></div>
                    </div>
                    
                    <!-- Hidden info container for TME data -->
                    <div id="tme-analysis-info" style="display: none;"></div>
                </div>
            </div>

            <!-- Image Information Section -->
            <div class="section">
                <div class="section-header" onclick="toggleSection(this)">
                    <span><i class="fas fa-info-circle"></i> Image Information</span>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="section-content">
                    <div class="info-item">
                        <label>File:</label>
                        <span id="metadata-filename">_SLIDE_INFO_</span>
                    </div>
                    <div class="info-item">
                        <label>Format:</label>
                        <span id="metadata-format">Deep Zoom Image</span>
                    </div>
                    <div class="info-item">
                        <label>Channel:</label>
                        <span>_CHANNEL_NAME_</span>
                    </div>
                    <div id="metadata-dimensions" class="info-item" style="display: none;">
                        <label>Dimensions:</label>
                        <span id="metadata-dimensions-value">-</span>
                    </div>
                    <div id="metadata-physical" class="info-item" style="display: none;">
                        <label>Physical Size:</label>
                        <span id="metadata-physical-value">-</span>
                    </div>
                    <div id="metadata-resolution" class="info-item" style="display: none;">
                        <label>Resolution:</label>
                        <span id="metadata-resolution-value">-</span>
                    </div>
                    <div id="metadata-magnification" class="info-item" style="display: none;">
                        <label>Magnification:</label>
                        <span id="metadata-magnification-value">-</span>
                    </div>
                    <div id="metadata-scandate" class="info-item" style="display: none;">
                        <label>Scan Date:</label>
                        <span id="metadata-scandate-value">-</span>
                    </div>
                    <div id="metadata-scanner" class="info-item" style="display: none;">
                        <label>Scanner:</label>
                        <span id="metadata-scanner-value">-</span>
                    </div>
                    <div id="metadata-filesize" class="info-item" style="display: none;">
                        <label>File Size:</label>
                        <span id="metadata-filesize-value">-</span>
                    </div>
                </div>
            </div>

            <!-- Viewing Options Section -->
            <div class="section">
                <div class="section-header" onclick="toggleSection(this)">
                    <span><i class="fas fa-eye"></i> Viewing Options</span>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="section-content">
                    <div class="control-item">
                        <label>
                            <input type="checkbox" id="showNavigator" checked> 
                            Show Navigator
                        </label>
                    </div>
                    <div class="control-item">
                        <label>
                            <input type="checkbox" id="showRotation" checked> 
                            Show Rotation Control
                        </label>
                    </div>
                    <div class="control-item">
                        <label>
                            <input type="checkbox" id="showScalebar" checked> 
                            Show Scale Bar
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Viewer Area -->
    <div class="viewer-area" id="mainContent">