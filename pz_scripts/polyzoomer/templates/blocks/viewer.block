<div id="_CONTENTID_" class="openseadragon" style="position: relative; width: 100%; height: 500px; overflow: visible;"></div>
<script type="text/javascript">
// Viewer for _VIEWERNAME_
var _VIEWER_VARNAME_ = OpenSeadragon({
    id:              "_CONTENTID_",
    prefixUrl:       "https://cdnjs.cloudflare.com/ajax/libs/openseadragon/2.1.0/images/",
    tileSources:     "_REL_PATH_TO_DZI_",
    preserveViewport: true,
    showRotationControl: true,
    showNavigator: true,
    showScaleControl: true
    });

_VIEWER_VARNAME_.addHandler("tile-drawing", function(event) {
    var ctx = event.context;
    if (ctx) {
        ctx.imageSmoothingEnabled = false;
        ctx.mozImageSmoothingEnabled = false;
        ctx.webkitImageSmoothingEnabled = false;
        ctx.msImageSmoothingEnabled = false;
    }
});

// Wrap annotation code in try-catch to prevent breaking metadata loading
try {
    _VIEWER_VARNAME_.Annotations();
    _VIEWER_VARNAME_.DrawAnnotations(OpenSeadragon.ControlAnchor.BOTTOM_RIGHT);
} catch(e) {
    console.warn("Annotation plugin initialization failed (non-fatal):", e);
}

// Make viewer globally accessible immediately
window._VIEWER_VARNAME_ = _VIEWER_VARNAME_;

// Define metadata loading function
function loadAndDisplayMetadata() {
    var metadataPath = "_REL_PATH_TO_DZI_".replace('.dzi', '_metadata.json');
    console.log("Fetching metadata from:", metadataPath);
    
    fetch(metadataPath)
        .then(response => {
            if (!response.ok) {
                throw new Error('Metadata not found');
            }
            return response.json();
        })
        .then(metadata => {
            console.log("Metadata loaded:", metadata);
            
            var metadataKey = '_VIEWER_VARNAME_' + 'Metadata';
            window[metadataKey] = metadata;
            
            // Wait for updateMetadataDisplay to be available
            var checkFunction = function() {
                if (typeof updateMetadataDisplay === 'function') {
                    updateMetadataDisplay(metadata, '_VIEWER_VARNAME_');
                } else {
                    console.log("Waiting for updateMetadataDisplay...");
                    setTimeout(checkFunction, 100);
                }
            };
            checkFunction();
            
            // Add scalebar if available
            if (metadata.hasScale && metadata.mppX && metadata.mppY) {
                setTimeout(function() {
                    try {
                        var pixelsPerMeter = 1000000 / metadata.mppX;
                        var scalebar = new OpenSeadragon.Scalebar({
                            viewer: _VIEWER_VARNAME_,
                            minWidth: "100px",
                            pixelsPerMeter: pixelsPerMeter,
                            location: OpenSeadragon.ScalebarLocation.BOTTOM_LEFT,
                            color: "black",
                            fontColor: "black",
                            backgroundColor: "rgba(255, 255, 255, 0.8)",
                            barThickness: 3,
                            fontSize: "12px"
                        });
                        
                        console.log("Scalebar created successfully");
                        _VIEWER_VARNAME_._customScalebar = scalebar;
                        
                    } catch(error) {
                        console.error("Error creating scalebar:", error);
                    }
                }, 300);
            }
        })
        .catch(error => {
            console.log("Metadata fetch failed:", error);
        });
}

// Attach handler for 'open' event
_VIEWER_VARNAME_.addHandler('open', function() {
    console.log("Viewer opened for _VIEWER_VARNAME_");
    loadAndDisplayMetadata();
});

// Check if already open and load immediately
if (_VIEWER_VARNAME_.isOpen()) {
    console.log("Viewer already open, loading metadata immediately");
    loadAndDisplayMetadata();
}

var handleResize = function() {
    var height = jQuery('#_CONTENTID_').height();
    var couldHeight = jQuery('td.OSD').height() * 0.9;
    if(height == 0) {
        jQuery('#_CONTENTID_').height(couldHeight + 'px');
    }
};

// toggle navigator visible
const navigatorCheckbox = document.getElementById('showNavigator');
navigatorCheckbox.addEventListener('change', toggleNavigator);
</script>